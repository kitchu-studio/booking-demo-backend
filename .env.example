# Copy to .env and change every value. Never commit .env
APP_ENV=development
PORT=8080

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Must be at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Domain served by Caddy (use "localhost" for local, your real domain on the server)
DOMAIN=localhost

# Shop opening hours (booking times). Slot must divide 60: 15, 30 or 60.
BUSINESS_TZ=Asia/Bangkok
OPEN_HOUR=9
CLOSE_HOUR=18
SLOT_MINUTES=30
